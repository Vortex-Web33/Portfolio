---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/sections/PageHero.astro";
import ContactSection from "../components/sections/ContactSection.astro";
---

<Layout
  title="Contacto y Presupuesto"
  description="Contacta con la agencia VORTEX para tu presupuesto: por teléfono, email o en nuestra oficina de Madrid. Te respondemos rápido."
>
  <PageHero
    kicker="Let's gooo !!"
    title={'¿Necesitas un <span class="highlight-gradient">sitio web</span>?'}
    description="¡Lo hablamos!"
    glowClass="bg-vortex/15"
  />

  <ContactSection />
</Layout>
