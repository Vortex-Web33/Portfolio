---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import ComingSoonSection from "@/components/sections/ComingSoonSection.astro";
---

<Layout
  title="Observatorio de Agencias Web"
  description="Analizamos el mercado de las agencias web en Madrid y en España: tarifas, plazos y calidad, para ayudarte a elegir bien."
>
  <PageHero
    kicker="Observatorio"
    title={'Observatorio de <span class="highlight-gradient">Agencias Web</span>'}
    description="Analizamos el mercado de las agencias web en Madrid y en España para ayudarte a elegir bien."
    glowClass="bg-vortex-green/15"
  />

  <ComingSoonSection
    icon="◉"
    title="El estudio está en curso"
    description="Estamos recopilando datos sobre tarifas, plazos y calidad de las agencias web. Los resultados se publicarán aquí próximamente."
    ctaText="Solicitar presupuesto"
  />
</Layout>
