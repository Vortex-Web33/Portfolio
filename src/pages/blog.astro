---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import ComingSoonSection from "@/components/sections/ComingSoonSection.astro";
---

<Layout
  title="El Blog"
  description="Ideas y consejos sobre creación de sitios web, posicionamiento SEO y automatización. El blog de la agencia VORTEX."
>
  <PageHero
    kicker="El Blog"
    title={'Ideas y <span class="highlight-gradient">consejos</span>'}
    description="Consejos para crear un sitio que funciona, entender Google y dominar lo digital sin humo."
    glowClass="bg-vortex-blue/15"
  />

  <ComingSoonSection
    icon="✎"
    title="Artículos próximamente"
    description="Estamos preparando artículos sobre creación de sitios web, posicionamiento SEO y automatización. Vuelve pronto o suscríbete a nuestra newsletter."
    ctaText="Contactar"
  />
</Layout>
