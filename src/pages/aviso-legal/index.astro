---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import { contact } from "../../config/site";
---

<Layout title="Aviso Legal" noindex description="Aviso legal de la agencia VORTEX: editor del sitio, propiedad intelectual, datos personales y alojamiento.">
  <PageHero
    kicker="Legal"
    title={'Aviso <span class="highlight-gradient">legal</span>'}
    glowClass="bg-vortex-coral/15"
  />

  <section class="mx-auto max-w-3xl px-6 pb-24">
    <div data-reveal class="space-y-10 text-sm leading-relaxed text-cream/70">
      <div>
        <h2 class="mb-3 text-lg font-bold text-white">Editor del sitio</h2>
        <p>
          Agencia VORTEX<br />
          {contact.address.street}<br />
          {contact.address.postalCode} {contact.address.city} – {contact.address.country}<br />
          Tel: <a href={contact.phoneHref} class="text-vortex hover:underline">{contact.phone}</a><br />
          Email: <a href={contact.emailHref} class="text-vortex hover:underline">{contact.email}</a>
        </p>
      </div>
      <div>
        <h2 class="mb-3 text-lg font-bold text-white">Propiedad intelectual</h2>
        <p>
          Los contenidos de este sitio (textos, logotipos, visuales y estructura) son propiedad de
          la agencia VORTEX o de sus clientes. Queda prohibida su reproducción sin autorización
          previa por escrito.
        </p>
      </div>
      <div>
        <h2 class="mb-3 text-lg font-bold text-white">Datos personales</h2>
        <p>
          Este sitio no recopila datos personales sin tu consentimiento. Para cualquier solicitud
          relativa a tus datos, escríbenos a {contact.email}.
        </p>
      </div>
      <div>
        <h2 class="mb-3 text-lg font-bold text-white">Alojamiento</h2>
        <p>
          Sitio alojado por un proveedor de alojamiento web profesional. Los datos de contacto
          del alojamiento están disponibles bajo petición.
        </p>
      </div>
    </div>
  </section>
</Layout>
