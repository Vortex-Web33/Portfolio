---
// Página de inicio: compone todas las secciones del sitio (hero, clientes, intro,
// marquesinas, proyectos con CardStack, servicios, agencia, CTA y contacto).
import Layout from "@/layouts/Layout.astro";
import Hero from "@/sections/Hero.astro";
import ClientsMarquee from "@/sections/ClientsMarquee.astro"; // Borrado pq ahora mismo no tenemos clientes
import IntroSection from "@/sections/IntroSection.astro";
import ReviewsSection from "@/sections/ReviewsSection.astro";
import PageHero from "@/sections/PageHero.astro";
import ProjectsSection from "@/sections/ProjectsSection.astro";
import ServicesSection from "@/sections/ServicesSection.astro";
import ContactSection from "@/sections/ContactSection.astro";
import BigWordsMarquee from "@/sections/BigWordsMarquee.astro";
import Container from "@/components/ui/Container.astro";
---

<Layout title="Vortex - Agencia de Marketing Digital">
  <Hero />
  <BigWordsMarquee
    words={[
      "VORTEX ",
      "❋",
      "VORTEX",
      "❊",
      "VORTEX",
      "❈",
      "VORTEX",
      "✢",
      "VORTEX",
      "❋",
    ]}
    direction="rtl"
    speed={50}
  />

  <Container className="py-24">
    <PageHero
      title={'<span class="highlight-gradient">¿Quiénes somos?</span>'}
    />
    <IntroSection />
  </Container>

  <Container className="py-24">
    <PageHero
      kicker="Proyectos"
      title={'<span class="highlight-gradient">Proyectos que nos hicieron exprimir el cerebro</span>'}
    />
  </Container>

  <div id="proyectos" class="pb-44">
    <ProjectsSection />
  </div>


  <Container className="py-24">
    <PageHero
      kicker="Lo que hacemos a la perfección"
      title={'<span class="highlight-gradient">Nuestros servicios</span>'}
      description="Del sitio vitrina a la tienda online, pasando por el posicionamiento y la estrategia digital… Gestionamos todo para que tu presencia en línea esté a la altura de tus ambiciones."
    />
  </Container>

  <div id="servicios">
    <ServicesSection />
  </div>

  <ReviewsSection />

  <div id="contacto">
    <ContactSection />
  </div>
</Layout>
