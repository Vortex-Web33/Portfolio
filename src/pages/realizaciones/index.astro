---
import Layout from "../../layouts/Layout.astro";
import ProjectCards from "../../components/ProjectCards.astro";
---

<Layout title="Realizaciones">
  <section class="relative overflow-hidden px-6 pt-44 pb-20 text-center">
    <div class="pointer-events-none absolute -top-32 left-1/2 size-96 -translate-x-1/2 rounded-full bg-vortex-blue/15 blur-[120px]"></div>
    <div class="relative mx-auto max-w-3xl">
      <p data-hero-anim class="kicker mb-4 text-cream/40">Realizaciones</p>
      <h1 data-hero-anim class="text-5xl font-bold tracking-tight text-white md:text-7xl">
        Proyectos <span class="highlight-gradient">fuera de lo común</span>
      </h1>
      <p data-hero-anim class="mx-auto mt-8 max-w-2xl font-mono text-sm leading-relaxed text-cream/60">
        Sitios que nos obligaron a exprimir el cerebro. Eso es lo que nos gusta: los retos que nos
        hacen progresar, no los copia-pega.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-24">
    <ProjectCards />
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24 text-center">
    <div data-reveal>
      <p class="mt-16 font-mono text-xs tracking-[0.3em] text-cream/40 uppercase">
        Tu proyecto podría ser el próximo
      </p>
      <a href="/contacto/" class="btn mt-6">Solicitar presupuesto</a>
    </div>
  </section>
</Layout>
