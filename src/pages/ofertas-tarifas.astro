---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/sections/PageHero.astro";
import PricingSection from "../components/sections/PricingSection.astro";
---

<Layout
  title="Ofertas y Tarifas"
  description="Ofertas y tarifas de la agencia VORTEX: sitios vitrina, tiendas online y acompañamiento SEO. Presupuestos a medida."
>
  <PageHero
    kicker="Ofertas"
    title={'Ofertas y <span class="highlight-gradient">tarifas</span>'}
    description="No nos gustan los paquetes de talla única. Cada proyecto se presupuesta según tu necesidad. Pero para darte una idea, aquí tienes nuestros puntos de partida."
    glowClass="bg-vortex-green/15"
  />

  <PricingSection />
</Layout>
