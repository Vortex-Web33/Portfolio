---
import Layout from "../../layouts/Layout.astro";
import ServicesGrid from "../../components/ServicesGrid.astro";
---

<Layout title="Servicios">
  <section class="relative overflow-hidden px-6 pt-44 pb-20 text-center">
    <div class="pointer-events-none absolute -top-32 left-1/2 size-96 -translate-x-1/2 rounded-full bg-vortex/15 blur-[120px]"></div>
    <div class="relative mx-auto max-w-3xl">
      <p data-hero-anim class="kicker mb-4 text-cream/40">Lo que hacemos a la perfección</p>
      <h1 data-hero-anim class="text-5xl font-bold tracking-tight text-white md:text-7xl">
        Nuestros <span class="highlight-gradient">servicios</span>
      </h1>
      <p data-hero-anim class="mx-auto mt-8 max-w-2xl font-mono text-sm leading-relaxed text-cream/60">
        Del sitio vitrina a la tienda online, pasando por el posicionamiento y la estrategia digital…
        Gestionamos todo para que tu presencia en línea esté a la altura de tus ambiciones.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-24">
    <ServicesGrid />
  </section>
</Layout>
