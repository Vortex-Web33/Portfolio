---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Contacto y Presupuesto">
  <section class="relative overflow-hidden px-6 pt-44 pb-24 text-center">
    <div class="pointer-events-none absolute -top-32 left-1/2 size-96 -translate-x-1/2 rounded-full bg-vortex/15 blur-[120px]"></div>
    <div class="relative mx-auto max-w-3xl">
      <p data-hero-anim class="kicker mb-6 text-vortex">Let's gooo !!</p>
      <h1 data-hero-anim class="text-5xl font-bold tracking-tight text-white md:text-7xl">
        ¿Necesitas un <span class="highlight-gradient">sitio web</span>?
      </h1>
      <p data-hero-anim class="mt-6 font-mono text-sm text-cream/50">¡Lo hablamos!</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="grid gap-8 md:grid-cols-3">
      <a data-reveal href="tel:+34663007473" class="group flex flex-col items-center gap-6 rounded-3xl border border-white/5 bg-ink-soft/30 p-12 text-center transition-all duration-300 hover:-translate-y-1 hover:border-vortex/50">
        <span class="flex size-16 items-center justify-center rounded-full border border-white/10 font-mono text-xl text-cream/60 transition-colors duration-300 group-hover:border-vortex/60 group-hover:text-vortex">☎</span>
        <span class="text-lg font-bold text-white">Por teléfono</span>
        <span class="font-mono text-sm text-cream/60">+34 663 00 74 73</span>
      </a>
      <a data-reveal href="mailto:hello@vortex.agency" class="group flex flex-col items-center gap-6 rounded-3xl border border-white/5 bg-ink-soft/30 p-12 text-center transition-all duration-300 hover:-translate-y-1 hover:border-vortex/50">
        <span class="flex size-16 items-center justify-center rounded-full border border-white/10 font-mono text-xl text-cream/60 transition-colors duration-300 group-hover:border-vortex/60 group-hover:text-vortex">✉</span>
        <span class="text-lg font-bold text-white">Por email</span>
        <span class="font-mono text-sm text-cream/60">hello@vortex.agency</span>
      </a>
      <div data-reveal class="flex flex-col items-center gap-6 rounded-3xl border border-white/5 bg-ink-soft/30 p-12 text-center">
        <span class="flex size-16 items-center justify-center rounded-full border border-white/10 font-mono text-xl text-cream/60">◈</span>
        <span class="text-lg font-bold text-white">En la agencia</span>
        <span class="font-mono text-sm leading-relaxed text-cream/60">
          Agencia VORTEX<br />
          Calle de Ferrandière<br />
          <strong class="text-white">28013 Madrid – España</strong>
        </span>
      </div>
    </div>

    <div data-reveal class="mt-20 text-center">
      <p class="kicker mb-4 text-cream/40">Es ahora cuando empieza</p>
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white md:text-5xl">
        Es ahora cuando <span class="highlight-gradient">empieza</span>
      </h2>
      <a href="mailto:hello@vortex.agency" class="btn mt-8">Solicitar presupuesto</a>
    </div>
  </section>
</Layout>
