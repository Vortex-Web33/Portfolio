---
import { navItems } from "@/config/site";
---

<header class="site-header fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
    <a href="/" class="font-mono text-xl font-bold tracking-tight text-white" aria-label="VORTEX - Inicio">
      VORTEX<span class="text-vortex">.</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegación principal">
      {
        navItems
          .filter((item) => item.href !== "/contacto/")
          .map((item) =>
            item.children ? (
              <div class="group relative">
                <a href={item.href} class="text-sm text-cream/70 hover:text-white">{item.label} ▾</a>
                <div class="invisible absolute left-1/2 top-full w-72 -translate-x-1/2 translate-y-2 rounded-2xl border border-white/10 bg-ink p-4 opacity-0 shadow-2xl transition-all duration-300 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-xl px-4 py-2 text-sm text-cream/70 hover:bg-white/5 hover:text-white"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={item.href} class="text-sm text-cream/70 hover:text-white">{item.label}</a>
            ),
          )
      }
    </nav>

    <div class="flex items-center gap-4">
      <a href="/contacto/" class="btn hidden px-6 py-3 text-sm md:inline-flex">Contacto y Presupuesto</a>
      <button
        class="menu-toggle flex size-10 flex-col items-center justify-center gap-1.5 lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="h-0.5 w-6 bg-white"></span>
        <span class="h-0.5 w-6 bg-white"></span>
        <span class="h-0.5 w-6 bg-white"></span>
      </button>
    </div>
  </div>
</header>

<nav id="mobile-nav" class="mobile-nav fixed inset-x-0 top-0 z-40 flex h-screen flex-col items-center justify-center gap-8 bg-ink pt-20 lg:hidden" aria-label="Menú móvil">
  {
    navItems.map((item) => (
      <a href={item.href} class="text-2xl font-bold text-white">{item.label}</a>
    ))
  }
</nav>
