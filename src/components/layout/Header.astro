---
// Cabecera fija superior con logo Vortex, navegación desktop y burger menu móvil.
import Button from "@/components/ui/Button.astro";
---

<header class="site-header fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
    <a
      href="/"
      class="font-mono text-xl font-bold tracking-tight text-white"
      aria-label="VORTEX - Inicio"
    >
      VORTEX<span class="text-vortex">.</span>
    </a>

    <div class="flex items-center gap-8">
      <Button href="/#contacto" class="hidden px-5 py-2.5 text-sm md:inline-flex">
        Contacto y Presupuesto
      </Button>

      <!-- Burger menu button (mobile only) -->
      <button
        id="burger-btn"
        class="md:hidden flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 border border-white/10 text-white transition-colors hover:bg-white/10"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="burger-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12h18" />
          <path d="M3 6h18" />
          <path d="M3 18h18" />
        </svg>
        <svg id="burger-close" class="h-6 w-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-0 z-40 md:hidden transform translate-y-[-100%] transition-transform duration-500 ease-out bg-ink/95 backdrop-blur-md border-b border-white/10"
    role="dialog"
    aria-label="Menú de navegación"
  >
    <div class="mx-auto max-w-7xl px-6 py-6">
      <!-- Close button -->
      <button
        id="mobile-menu-close"
        class="absolute top-6 right-6 flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 border border-white/10 text-white transition-colors hover:bg-white/10"
        aria-label="Cerrar menú"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>

      <nav class="space-y-5 pt-14">
        <a href="/" class="mobile-nav-link block text-2xl font-medium text-white hover:text-vortex transition-colors">Inicio</a>
        <a href="/#servicios" class="mobile-nav-link block text-2xl font-medium text-white hover:text-vortex transition-colors">Servicios</a>
        <a href="/#proyectos" class="mobile-nav-link block text-2xl font-medium text-white hover:text-vortex transition-colors">Proyectos</a>
        <a href="/#reseñas" class="mobile-nav-link block text-2xl font-medium text-white hover:text-vortex transition-colors">Reseñas</a>
        <a href="/#contacto" class="mobile-nav-link block text-2xl font-medium text-white hover:text-vortex transition-colors">Contacto</a>
      </nav>
    </div>
  </div>

  <!-- Overlay -->
  <div id="mobile-menu-overlay" class="fixed inset-0 z-30 bg-black/50 opacity-0 invisible transition-opacity duration-300 md:hidden" aria-hidden="true"></div>
</header>

<script>
  import "@/scripts/header.ts";
</script>
