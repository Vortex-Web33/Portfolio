---
// Pie de página: ola decorativa animada en el borde superior (GSAP + MorphSVGPlugin,
// ver src/scripts/footer-wave.ts), y contacto/redes sociales desde la config.
import { contact, socials } from "@/lib/config/site";
---

<footer class="footer">
  <div class="footer-wave" aria-hidden="true">
    <svg
      preserveAspectRatio="none"
      id="footer-img"
      class="footer-img"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 2278 683"
    >
      <defs>
        <linearGradient
          id="footer-grad"
          x1="0"
          y1="0"
          x2="2278"
          y2="683"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0.2" stop-color="#fec5fb"></stop>
          <stop offset="0.8" stop-color="#00bae2"></stop>
        </linearGradient>
      </defs>
      <path
        class="footer-svg"
        id="bouncy-path"
        fill="url(#footer-grad)"
        d="M0-0.3C0-0.3,464,156,1139,156S2278-0.3,2278-0.3V683H0V-0.3z"
      />
    </svg>
  </div>

  <div class="mx-auto max-w-7xl px-6 pb-10">
    <div class="grid gap-12 border-t border-hairline/40 py-16 md:grid-cols-2">
      <div>
        <strong class="kicker text-cream/40">Contacto</strong>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={contact.emailHref} class="text-cream/70 hover:text-vortex"
              >{contact.email}</a
            >
          </li>
          <li class="text-cream/50">
            {contact.address.street}
            <br />
            {contact.address.city} – {contact.address.country}
          </li>
        </ul>
      </div>

      <nav aria-label="Redes sociales">
        <strong class="kicker text-cream/40">Redes</strong>
        <ul class="mt-4 space-y-3 text-sm">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-cream/70 hover:text-vortex"
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-hairline/40 py-8 text-xs text-cream/40 md:flex-row"
    >
      <p>
        © {new Date().getFullYear()} Agencia VORTEX – Todos los derechos reservados
      </p>
    </div>
  </div>
</footer>

<script>
  import "@/scripts/footer-wave.ts";
</script>
