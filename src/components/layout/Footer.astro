---
// Pie de página: ola animada que ocupa TODO el footer (SVG de gradiente absoluto,
// morfeado con GSAP + MorphSVGPlugin, ver src/scripts/footer-wave.ts). El contenido
// va encima con z-10 y texto en ink para leer sobre el degradado claro.
// Marca, navegación, contacto y redes desde la config.
import { contact, socials, site } from "@/lib/config/site";
import Button from "@/components/ui/Button.astro";
---

<footer class="footer">
  <div class="footer-wave" aria-hidden="true">
    <svg
      preserveAspectRatio="none"
      id="footer-img"
      class="footer-img"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 2278 683"
    >
      <defs>
        <linearGradient
          id="footer-grad"
          x1="0"
          y1="0"
          x2="2278"
          y2="683"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0.2" stop-color="#fec5fb"></stop>
          <stop offset="0.8" stop-color="#00bae2"></stop>
        </linearGradient>
      </defs>
      <path
        class="footer-svg"
        id="bouncy-path"
        fill="url(#footer-grad)"
        d="M0 0 C0 0,464 260,1139 260 S1814 260,2278 0 V683 H0 V0 z"
      />
    </svg>
  </div>

  <div class="footer-content relative z-10 mx-auto max-w-7xl px-6 pb-10">
    <div class="grid gap-12 border-t border-ink/15 py-16 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <p class="kicker text-ink/50">Agencia Web & Posicionamiento SEO</p>
        <a
          href="/"
          class="mt-4 block text-4xl font-bold tracking-tight text-ink md:text-5xl"
          aria-label="VORTEX - Inicio"
        >
          VORTEX<span class="text-white">.</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink/60">
          Creamos sitios web a medida que convierten visitantes en clientes.
          Con sede en {contact.address.city}, para todo el mundo.
        </p>
        <Button href="/#contacto" class="mt-8 px-7 py-3.5 text-sm">
          Hablemos de tu proyecto
        </Button>
      </div>

      <!-- Navegación: oculta en móvil -->
      <nav class="hidden lg:block" aria-label="Navegación">
        <strong class="kicker text-ink/50">Navegación</strong>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href="/" class="text-ink/70 transition-colors hover:text-ink">Inicio</a>
          </li>
          <li>
            <a href="/#servicios" class="text-ink/70 transition-colors hover:text-ink">Servicios</a>
          </li>
          <li>
            <a href="/#proyectos" class="text-ink/70 transition-colors hover:text-ink">Proyectos</a>
          </li>
          <li>
            <a href="/#reviews" class="text-ink/70 transition-colors hover:text-ink">Reseñas</a>
          </li>
          <li>
            <a href="/#contacto" class="text-ink/70 transition-colors hover:text-ink">Contacto</a>
          </li>
        </ul>
      </nav>


      <!-- Contacto: oculta en móvil -->
      <div class="hidden lg:block">
        <strong class="kicker text-ink/50">Contacto</strong>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={contact.emailHref} class="text-ink/70 hover:text-ink"
              >{contact.email}</a
            >
          </li>
          <li class="text-ink/55">
            {contact.address.postalCode} {contact.address.city} –{" "}
            {contact.address.country}
          </li>
        </ul>
      </div>

      <nav aria-label="Redes sociales">
        <strong class="kicker text-ink/50">Redes</strong>
        <ul class="mt-4 space-y-3 text-sm">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink/70 hover:text-ink"
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-ink/15 py-8 text-xs text-ink/50 md:flex-row"
    >
      <p>
        © {new Date().getFullYear()} {site.legalName} – Todos los derechos
        reservados
      </p>
      <a href="#contenido" class="font-mono transition-colors hover:text-ink">
        Volver arriba ↑
      </a>
    </div>
  </div>
</footer>

<script>
  import "@/scripts/footer-wave.ts";
</script>
