---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { kicker, title, description, align = "left" } = Astro.props;
---

<div class:list={[
  "mb-16 max-w-2xl",
  align === "center" && "mx-auto text-center",
]} data-reveal>
  {kicker && <p class="kicker mb-4 text-cream/40">{kicker}</p>}
  <h2 class="text-4xl font-bold tracking-tight text-white md:text-5xl" set:html={title} />
  {description && <p class="mt-6 leading-relaxed text-cream/60" set:html={description} />}
</div>
