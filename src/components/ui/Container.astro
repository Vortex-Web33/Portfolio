---
// Contenedor de ancho máximo centrado (max-w-7xl) con padding lateral; opcionalmente
// cambia la etiqueta del elemento (div/section/header/footer) y acepta clases extra.
interface Props {
  className?: string;
  as?: "div" | "section" | "header" | "footer";
}

const { className = "", as: Tag = "div" } = Astro.props;
---

<Tag class:list={["mx-auto w-full max-w-7xl px-6", className]}>
  <slot />
</Tag>
