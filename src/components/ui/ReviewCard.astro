---
// Tarjeta de reseña fiel a Terral Studio — Reviews.B4YnFDsH.js
// w-[350px] md:w-[450px] con quote, avatar y datos del autor.
interface Props {
  name: string;
  role: string;
  body: string;
  img: string;
}

const { name, role, body, img } = Astro.props;
---

<div
  class="w-[350px] md:w-[450px] shrink-0 mx-4 p-8 rounded-[32px] bg-white/3 border border-white/10 backdrop-blur-sm shadow-[0_8px_32px_0_rgba(0,0,0,0.3)] transition-all duration-300 hover:bg-white/6 hover:border-white/20 flex flex-col gap-4"
>
  <p class="text-white/80 text-lg font-light leading-relaxed italic text-balance">
    "{body}"
  </p>
  <div class="flex items-center gap-4 mt-4">
    <div class="w-12 h-12 shrink-0 rounded-full overflow-hidden border-2 border-vortex/30 shadow-lg shadow-vortex/10 bg-neutral-800">
      <img
        src={img}
        alt={name}
        class="w-full h-full object-cover object-center"
        loading="lazy"
        width="48"
        height="48"
      />
    </div>
    <div class="overflow-hidden">
      <p class="font-bold text-white/90 text-lg tracking-tight truncate">{name}</p>
      <p class="text-vortex/60 text-[10px] uppercase tracking-[0.2em] font-medium truncate">
        {role}
      </p>
    </div>
  </div>
</div>
