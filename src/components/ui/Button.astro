---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "variant"> {
  href: string;
  variant?: "primary" | "dark";
  external?: boolean;
}

const { href, variant = "primary", external = false, class: className = "", ...rest } = Astro.props;

const cls = `${variant === "primary" ? "btn" : "btn-dark"} ${className}`.trim();
---

<a href={href} class={cls} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})} {...rest}>
  <slot />
</a>