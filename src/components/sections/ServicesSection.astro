---
import { services } from "../../data/services";
---

<ul class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
  {
    services.map((service) => (
      <li data-reveal>
        <a
          href={service.href}
          class:list={[
            service.accent,
            "group flex h-full flex-col gap-10 rounded-3xl border border-white/5 bg-gradient-to-br to-transparent p-10 transition-all duration-300 hover:-translate-y-1 hover:border-white/15 hover:bg-ink-soft/60",
          ]}
        >
          <span class="flex size-20 items-center justify-center rounded-full border border-white/10 font-mono text-2xl text-cream/80 transition-colors duration-300 group-hover:border-vortex/60 group-hover:text-vortex">
            {service.glyph}
          </span>
          <div class="flex flex-1 flex-col gap-4">
            <h3 class="text-2xl font-bold text-white">{service.title}</h3>
            <p class="text-sm leading-relaxed text-cream/60">{service.description}</p>
          </div>
          <span class="font-mono text-xs tracking-widest uppercase text-cream/50 transition-colors duration-300 group-hover:text-vortex">
            Descubrir →
          </span>
        </a>
      </li>
    ))
  }
</ul>
