---
import { pricingPlans } from "../../data/pricing";
import Button from "../ui/Button.astro";
---

<section class="mx-auto max-w-6xl px-6 pb-24">
  <div class="grid gap-8 md:grid-cols-3">
    {
      pricingPlans.map((plan) => (
        <article
          data-reveal
          class:list={[
            "flex flex-col rounded-3xl border p-10",
            plan.featured
              ? "border-vortex/40 bg-ink-soft/40"
              : "border-white/5 bg-ink-soft/30",
          ]}
        >
          {plan.featured && (
            <span class="kicker absolute top-6 right-6 rounded-full bg-vortex px-3 py-1 text-[10px] text-ink">
              POPULAR
            </span>
          )}
          <h2 class="text-2xl font-bold text-white">{plan.name}</h2>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-cream/60">{plan.description}</p>
          <p class="mt-8 font-mono text-2xl font-bold text-vortex">{plan.price}</p>
          <Button
            href={plan.ctaHref}
            variant={plan.featured ? "primary" : "dark"}
            className="mt-6 w-full text-center text-sm"
          >
            {plan.ctaLabel}
          </Button>
        </article>
      ))
    }
  </div>
  <p data-reveal class="mt-12 text-center font-mono text-xs tracking-[0.3em] text-cream/40 uppercase">
    Tarifas indicativas — cada proyecto se estudia a medida
  </p>
</section>
