---
import Button from "@/components/ui/Button.astro";
import type { Service } from "@/types";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 pb-24">
  <div data-reveal class="grid gap-8 md:grid-cols-2">
    {
      service.features.map((feature) => (
        <article class="rounded-3xl border border-white/5 bg-ink-soft/30 p-10">
          <h2 class="text-2xl font-bold text-white">{feature.title}</h2>
          <p class="mt-4 leading-relaxed text-cream/60">{feature.description}</p>
        </article>
      ))
    }
  </div>
  <div data-reveal class="mt-16 text-center">
    <p class="mb-6 font-mono text-xs tracking-[0.3em] text-cream/40 uppercase">{service.ctaLabel}</p>
    <Button href="/contacto/">Solicitar presupuesto</Button>
  </div>
</section>
