---
import { projects } from "@/data/projects";
---

<ul class="grid gap-8">
  {
    projects.map((project, index) => (
      <li data-reveal>
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[project.bg, "group flex flex-col items-center gap-6 rounded-3xl px-8 py-20 text-center md:py-28"]}
          aria-label={`${project.name} ${project.tagline} - abrir sitio externo`}
        >
          <span class="font-mono text-xs tracking-[0.3em] text-white/70 uppercase">
            Proyecto {String(index + 1).padStart(2, "0")}
          </span>
          <span class="text-4xl font-bold tracking-tight text-white md:text-5xl">{project.name}</span>
          <span class="text-lg text-white/80">{project.tagline}</span>
          <span class="mt-4 inline-flex items-center gap-2 border-b border-white/40 pb-1 font-mono text-xs text-white transition-colors duration-300 group-hover:border-white group-hover:text-white">
            {project.url.replace("https://", "").replace(/\/$/, "")} →
          </span>
        </a>
      </li>
    ))
  }
</ul>
