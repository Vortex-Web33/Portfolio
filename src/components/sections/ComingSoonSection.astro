---
import Button from "@/components/ui/Button.astro";

interface Props {
  icon: string;
  title: string;
  description: string;
  ctaText?: string;
  ctaHref?: string;
}

const { icon, title, description, ctaText = "Contactar", ctaHref = "/contacto/" } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 pb-24">
  <div data-reveal class="flex flex-col items-center gap-8 rounded-3xl border border-white/5 bg-ink-soft/30 p-16 text-center">
    <span class="text-5xl" aria-hidden="true">{icon}</span>
    <h2 class="text-2xl font-bold text-white">{title}</h2>
    <p class="max-w-xl text-sm leading-relaxed text-cream/60">{description}</p>
    <Button href={ctaHref}>{ctaText}</Button>
  </div>
</section>
