---
import Button from "@/components/ui/Button";
import Reveal from "@/components/ui/Reveal";
---

<section class="relative overflow-hidden px-6 py-32 text-center">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-vortex/10 to-transparent"></div>
  <div class="relative mx-auto max-w-3xl">
    <Reveal client:load as="p" className="kicker mb-6 text-vortex">Let's gooo !!</Reveal>
    <Reveal client:load as="h2" className="text-5xl font-bold tracking-tight text-white md:text-7xl">
      ¿Necesitas un <span class="highlight-gradient">sitio web</span>?
    </Reveal>
    <Reveal client:load as="p" className="mt-6 font-mono text-sm text-cream/50">¡Lo hablamos!</Reveal>
    <Reveal client:load className="mt-10">
      <Button client:load href="/#contacto">Solicitar presupuesto</Button>
    </Reveal>
  </div>
</section>
