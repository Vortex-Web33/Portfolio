---
import Button from "@/components/ui/Button.astro";
---

<section class="relative overflow-hidden px-6 py-32 text-center">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-vortex/10 to-transparent"></div>
  <div class="relative mx-auto max-w-3xl">
    <p data-reveal class="kicker mb-6 text-vortex">Let's gooo !!</p>
    <h2 data-reveal class="text-5xl font-bold tracking-tight text-white md:text-7xl">
      ¿Necesitas un <span class="highlight-gradient">sitio web</span>?
    </h2>
    <p data-reveal class="mt-6 font-mono text-sm text-cream/50">¡Lo hablamos!</p>
    <div data-reveal class="mt-10">
      <Button href="/contacto/">Solicitar presupuesto</Button>
    </div>
  </div>
</section>
