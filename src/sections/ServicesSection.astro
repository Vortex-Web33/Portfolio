---
// Sección de servicios: galería horizontal con pin de scroll (GSAP, HorizontalGallery)
// que pasea los servicios de la agencia como paneles a lo ancho del viewport.
import HorizontalGallery from "@/components/ui/HorizontalGallery";
import type { GalleryPanel } from "@/components/ui/HorizontalGallery";
import { services } from "@/lib/data/services";

const panels: GalleryPanel[] = services.map((service) => ({
  id: service.slug,
  tagline: service.tagline,
  title: service.title,
  description: service.description,
  glyph: service.glyph,
  accent: service.accent,
  ctaLabel: service.ctaLabel,
  href: service.href,
  features: service.features,
}));
---

<HorizontalGallery items={panels} client:load />