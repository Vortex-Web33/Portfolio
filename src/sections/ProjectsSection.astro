---
import { CardStack } from "@/components/ui/CardStack";
import { projects } from "@/lib/data/projects";

const cards = projects.map((project) => ({
  id: project.name,
  title: project.name,
  description: project.tagline,
  imageSrc: project.image,
  href: project.url,
  tag: project.bg,
}));
---

<div class="overflow-x-clip">
  <CardStack
    client:load
    items={cards}
    autoAdvance
    intervalMs={1700}
    pauseOnHover
    showDots
    cardWidth={800}
    cardHeight={580}
  />
</div>