---
// Sección de proyectos: convierte "projects" en tarjetas y las muestra en el mazo
// CardStack en abanico (auto-advance, pause-on-hover, dots y swipe).
import { CardStack } from "@/components/ui/CardStack";
import { projects } from "@/lib/data/projects";

const cards = projects.map((project) => ({
  id: project.name,
  title: project.name,
  description: project.tagline,
  imageSrc: project.image,
  href: project.url,
  ctaLabel: "Ver proyecto",
  tag: project.bg,
}));
---

<div class="overflow-x-clip">
  <CardStack
    client:load
    items={cards}
    autoAdvance
    intervalMs={2500}
    pauseOnHover
    showDots
    cardWidth={800}
    cardHeight={580}
  />
</div>
