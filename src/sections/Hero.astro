---
import Button from "@/components/ui/Button";
import Reveal from "@/components/ui/Reveal";
import Grainient from "@/components/ui/Grainient";
import TextLoop from "@/components/ui/TextLoop";
import StickerTrail from "@/components/ui/StickerTrail";
---

<section class="relative overflow-hidden px-6 pt-44 pb-10 text-center">
  <Grainient
    client:load
    color1="#bc80bb"
    color2="#669aca"
    color3="#1a1a1a"
    className="absolute inset-0 opacity-30"
  />

  <div class="relative mx-auto max-w-5xl">
    <h1 class="text-5xl font-bold leading-tight tracking-tight text-white md:text-7xl">
      <Reveal client:load as="span" trigger="mount" delay={0.15} className="block">Agencia Web</Reveal>
      <Reveal client:load as="span" trigger="mount" delay={0.27} className="block">Posicionamiento SEO</Reveal>
      <Reveal client:load as="span" trigger="mount" delay={0.39} className="block">&amp; Marketing</Reveal>
    </h1>
    <Reveal
      client:load
      as="p"
      trigger="mount"
      delay={0.51}
      className="mx-auto mt-8 max-w-2xl font-mono text-sm leading-relaxed text-cream/60 md:text-base"
    >
      VORTEX es una <strong class="text-white">agencia web con sede en Madrid</strong> desde 2012.
      Hemos vivido los inicios de Internet; hoy creamos sitios para usuarios de{" "}
      <strong class="text-white">7 a 77 años.</strong>
    </Reveal>
    <Reveal
      client:load
      trigger="mount"
      delay={0.63}
      className="mt-12 flex flex-col items-center gap-6 md:flex-row md:justify-center"
    >
      <Button href="/#contacto">Solicitar presupuesto</Button>
      <a href="/#contacto" class="inline-flex items-center gap-2 font-mono text-xs tracking-widest text-cream/60 uppercase hover:text-white">
        Conocer la agencia →
      </a>
    </Reveal>
  </div>

  <div class="relative mx-auto -mt-10 max-w-7xl">
    <a href="/#contacto" class="group relative mx-auto flex size-52 items-center justify-center md:size-60" aria-label="Solicitar presupuesto">
      <TextLoop
        client:load
        shape="circle"
        text="¿Necesitas un presupuesto?"
        separator="·"
        speed={70}
        fontSize={21}
        fontWeight={600}
        letterSpacing={4}
        uppercase
        color="#c9c9c9"
        ribbon={false}
        className="absolute inset-0"
      />
      <span class="relative z-10 text-3xl text-vortex transition-transform duration-300 group-hover:scale-110" aria-hidden="true">❋</span>
    </a>
  </div>

  <StickerTrail client:load />
</section>
